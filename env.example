# Production environment variables
NODE_ENV=production
PORT=4000

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=meetings
DB_USERNAME=meetings
DB_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Bitrix
BITRIX_DEV_MODE=false
# Входящий вебхук Bitrix. Это СЕКРЕТ: сам URL и есть ключ доступа к CRM.
# Прежнее значение было закоммичено в репозиторий и должно быть отозвано
# в Bitrix24, а не просто удалено отсюда.
BITRIX_REST_URL=https://<ваш-портал>.bitrix24.by/rest/<user_id>/<webhook_code>
# Домены, с которых принимаются токены Bitrix (белый список против SSRF).
# Если не задано — берётся хост из BITRIX_REST_URL.
BITRIX_ALLOWED_DOMAINS=
ENABLE_LEADS_SYNC=false
ENABLE_CRON=true
# Через запятую — все домены, с которых открывается фронтенд.
# Внимание: в репозитории значение расходилось с доменом в README и certbot
# (centr-cred.by против centrcred.by). Проверьте, какой домен реальный.
CORS_ORIGIN=https://book-meeting.centrcred.by,https://book-meeting.centr-cred.by

# Security
# Лимит на IP, а весь офис — за одним NAT-адресом (12 операторов делят бюджет)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=3000

# Пул соединений к Postgres. Бронирование держит соединение на время
# транзакции с блокировкой слота, поэтому пула по умолчанию (5) не хватало.
DB_POOL_MAX=30
# Время жизни кеша сетки слотов, сек
SLOTS_CACHE_TTL=10
# Обязательны в production: сервер откажется стартовать со значениями
# по умолчанию или пустыми. Сгенерируйте: openssl rand -hex 32
ADMIN_JWT_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=
# Пары id:secret для виджета, через запятую
PUBLIC_TOKEN_PAIRS=
# Токен для внутренних cron-вызовов; пустой = путь отключён, остаётся админ-токен
CRON_TOKEN=

# Периодичность синхронизации лидов (cron-выражение)
LEADS_SYNC_CRON=*/5 * * * *

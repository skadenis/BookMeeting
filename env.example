# Production environment variables
NODE_ENV=production
PORT=4000

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=meetings
DB_USERNAME=meetings
DB_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Bitrix
BITRIX_DEV_MODE=false
# Входящий вебхук Bitrix. Это СЕКРЕТ: сам URL и есть ключ доступа к CRM.
# Прежнее значение было закоммичено в репозиторий и должно быть отозвано
# в Bitrix24, а не просто удалено отсюда.
BITRIX_REST_URL=https://<ваш-портал>.bitrix24.by/rest/<user_id>/<webhook_code>
# Домены, с которых принимаются токены Bitrix (белый список против SSRF).
# Если не задано — берётся хост из BITRIX_REST_URL.
BITRIX_ALLOWED_DOMAINS=
ENABLE_LEADS_SYNC=false
ENABLE_CRON=true
# Через запятую — все домены, с которых открывается фронтенд
CORS_ORIGIN=https://book-meeting.centr-cred.by

# Security
# Лимит на IP, а весь офис — за одним NAT-адресом (12 операторов делят бюджет)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=3000

# Пул соединений к Postgres. Бронирование держит соединение на время
# транзакции с блокировкой слота, поэтому пула по умолчанию (5) не хватало.
DB_POOL_MAX=30
# Время жизни кеша сетки слотов, сек
SLOTS_CACHE_TTL=10
# Обязательны в production: сервер откажется стартовать со значениями
# по умолчанию или пустыми. Сгенерируйте: openssl rand -hex 32
ADMIN_JWT_SECRET=
ADMIN_EMAIL=admin@centr-cred.by
ADMIN_NAME=Admin
ADMIN_PASSWORD=
# Пары id:secret для виджета, через запятую
PUBLIC_TOKEN_PAIRS=
# Токен для внутренних cron-вызовов; пустой = путь отключён, остаётся админ-токен
CRON_TOKEN=
# Ключ выгрузки встреч для платформы (Authorization: Bearer …); пусто — выгрузка выключена
EXPORT_TOKEN=
# Токен приёма событий Битрикса (POST /api/bitrix-events): application_token
# стандартного исходящего вебхука портала. Пусто — приём выключен
BITRIX_EVENTS_TOKEN=
# Окно склейки событий (мс): за окно — не больше одного crm.lead.list и одного
# crm.deal.list на каждые 50 ID. Лиды без незакрытой встречи в шахматке на
# сегодня/позже или за последние LOOKBACK часов отбрасываются без запроса
BITRIX_EVENTS_WINDOW_MS=15000
BITRIX_EVENTS_LOOKBACK_HOURS=24
# comment — оставлять в ленте лида комментарий, если встреча назначена в
# карточке мимо сетки и не легла в сетку (полный слот, время вне сетки,
# нет расписания). Пусто — только учёт в шахматке
BYPASS_FLAG_MODE=
# Сверка с Битриксом: раз в час за вчера и сегодня (плюс будущие встречи —
# отказы и переносы в карточке), ночью — за 7 дней
RECONCILE_CRON=7 * * * *
RECONCILE_DAYS=1
RECONCILE_NIGHTLY_CRON=15 4 * * *
RECONCILE_NIGHTLY_DAYS=7

# Опрос Битрикса (статусы сегодняшних встреч, встречи из карточки):
# без BITRIX_EVENTS_TOKEN — POLL_CRON, с событиями — POLL_CRON_WITH_EVENTS
POLL_CRON=*/5 * * * *
POLL_CRON_WITH_EVENTS=*/30 * * * *
